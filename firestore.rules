rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Helper Functions & Role Checks
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return isAuthenticated() ? getUserData().role : 'guest';
    }
    
    function isSuperAdmin() {
      return getUserRole() == 'super_admin';
    }
    
    function isTournamentAdmin() {
      return getUserRole() in ['super_admin', 'tournament_admin'];
    }
    
    function isReferee() {
      return getUserRole() in ['super_admin', 'tournament_admin', 'referee'];
    }
    
    function isFinanceAdmin() {
      return getUserRole() in ['super_admin', 'finance_admin'];
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Users Collection
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      allow create: if isAuthenticated() && (
        isOwner(userId) && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'player')
        || isSuperAdmin()
      );
      
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role)
        || isSuperAdmin()
      );
      
      allow delete: if isSuperAdmin();
    }

    // =========================================================================
    // 2. Tournaments Collection
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update, delete: if isTournamentAdmin();
      
      match /registrations/{registrationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isTournamentAdmin();
      }
    }

    // =========================================================================
    // 3. Teams Collection
    // =========================================================================
    match /teams/{teamId} {
      allow read: if true;
      
      allow create: if isAuthenticated() && request.resource.data.leaderId == request.auth.uid;
      
      allow update: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid 
        || isTournamentAdmin()
      );
      
      allow delete: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid 
        || isTournamentAdmin()
      );
    }

    // =========================================================================
    // 4. Matches Collection & Live Chat
    // =========================================================================
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isTournamentAdmin();
      allow update: if isReferee();
      
      match /chat_messages/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() 
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isReferee();
      }
    }

    // =========================================================================
    // 5. Rankings & Game Stats
    // =========================================================================
    match /rankings/{rankingId} {
      allow read: if true;
      allow write: if isTournamentAdmin();
    }
    
    match /game_stats/{gameId} {
      allow read: if true;
      allow write: if isTournamentAdmin();
    }

    // =========================================================================
    // 6. Wallets & Transactions
    // =========================================================================
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isFinanceAdmin();
      allow write: if isFinanceAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFinanceAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending'
      );
      
      allow update, delete: if isFinanceAdmin();
    }
  }
}
