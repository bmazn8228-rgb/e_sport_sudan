rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // Helper Functions & Role Checks
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function getUserRole() {
      return (isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid))) 
        ? (('role' in getUserData()) ? getUserData().role : 'player') 
        : 'guest';
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^(superadmin|admin)@esportsudan\\.sd$'))
        || getUserRole() in ['super_admin', 'superAdmin']
      );
    }
    
    function isTournamentAdmin() {
      return isSuperAdmin() || (isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^(tournament|organizer)@esportsudan\\.sd$'))
        || getUserRole() in ['super_admin', 'superAdmin', 'tournament_admin', 'tournamentAdmin', 'admin', 'organizer']
      ));
    }
    
    function isReferee() {
      return isTournamentAdmin() || (isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^referee@esportsudan\\.sd$'))
        || getUserRole() in ['referee']
      ));
    }
    
    function isFinanceAdmin() {
      return isSuperAdmin() || (isAuthenticated() && (
        (request.auth.token.email != null && request.auth.token.email.matches('(?i)^finance@esportsudan\\.sd$'))
        || getUserRole() in ['finance_admin', 'financeAdmin']
      ));
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // =========================================================================
    // 1. Users Collection
    // =========================================================================
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Allow user creation on signup (role cannot be self-assigned to admin)
      allow create: if isAuthenticated() && (
        (isOwner(userId) && (!('role' in request.resource.data) || request.resource.data.role in ['player', 'guest']))
        || isSuperAdmin()
      );
      
      // Allow user to update their own profile, but NOT change their own role unless SuperAdmin
      allow update: if isAuthenticated() && (
        (isOwner(userId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])))
        || isSuperAdmin()
        || isFinanceAdmin()
      );
      
      allow delete: if isSuperAdmin();

      // User Notifications Subcollection
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isSuperAdmin();
        allow create: if isAuthenticated();
      }

      // Bank Accounts Subcollection
      match /bank_accounts/{accountId} {
        allow read, write: if isOwner(userId) || isSuperAdmin() || isFinanceAdmin();
      }
    }

    // =========================================================================
    // 2. Tournaments Collection
    // =========================================================================
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isTournamentAdmin();
      allow update, delete: if isTournamentAdmin();
      
      match /registrations/{registrationId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isTournamentAdmin();
      }
    }

    // =========================================================================
    // 3. Teams Collection
    // =========================================================================
    match /teams/{teamId} {
      allow read: if true;
      
      allow create: if isAuthenticated();
      
      allow update: if isAuthenticated(); // Allowed for users to join/leave team roster
      
      allow delete: if isAuthenticated() && (
        resource.data.leaderId == request.auth.uid 
        || isTournamentAdmin()
      );
    }

    // =========================================================================
    // 4. Matches Collection & Live Chat
    // =========================================================================
    match /matches/{matchId} {
      allow read: if true;
      allow create, delete: if isTournamentAdmin();
      allow update: if isReferee();
      
      match /chat_messages/{messageId} {
        allow read: if true;
        allow create: if isAuthenticated() 
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isReferee();
      }
    }

    // =========================================================================
    // 5. Rankings & Game Stats
    // =========================================================================
    match /rankings/{rankingId} {
      allow read: if true;
      allow write: if isTournamentAdmin();
    }
    
    match /game_stats/{gameId} {
      allow read: if true;
      allow write: if isTournamentAdmin();
    }

    // =========================================================================
    // 6. Wallets & Transactions
    // =========================================================================
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isFinanceAdmin();
      allow write: if isFinanceAdmin();
    }

    match /transactions/{txId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isFinanceAdmin() || isSuperAdmin()
      );
      
      allow create: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid 
        && request.resource.data.status == 'pending'
      );
      
      allow update, delete: if isFinanceAdmin() || isSuperAdmin();
    }

    // =========================================================================
    // 7. Complaints
    // =========================================================================
    match /complaints/{complaintId} {
      allow read, update, delete: if isTournamentAdmin();
      allow create: if isAuthenticated();
    }

    // =========================================================================
    // 8. Settings
    // =========================================================================
    match /settings/{document} {
      allow read: if true;
      allow write: if isTournamentAdmin();
      
      match /bank_accounts/{accountId} {
        allow read: if isAuthenticated();
        allow write: if isSuperAdmin();
      }
    }

    // =========================================================================
    // 9. News Collection
    // =========================================================================
    match /news/{newsId} {
      allow read: if true;
      allow write: if isTournamentAdmin();
    }

    // =========================================================================
    // 10. Global Notifications (if created at root)
    // =========================================================================
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || isTournamentAdmin();
    }
  }
}
